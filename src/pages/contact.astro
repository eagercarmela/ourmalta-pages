---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
<head>
  <BaseHead
    title="Get in touch"
    description="Contact Our Malta"
  />
</head>

<body>
  <Header />

  <main>

    <h1>Get in touch</h1>

    <p>Pause for a moment...</p>

    <p>
      Imagine something uniquely Maltese. What comes to mind?
    </p>

    <p>
      What experience, place, skill, or tradition deserves to be shared?
    </p>

    <p>
      Your perspective could inspire the next great experience in Malta.
    </p>

    <p>
      We're listening. Share your idea, ask a question, or simply start a conversation.
    </p>

    <hr />

    <form>

      <p style="margin-bottom:12px;">
        <label for="topic">What is this about?</label><br />
        <select
          id="topic"
          name="topic"
          style="width:320px; padding:8px; font-size:16px; margin-top:6px;"
        >
          <option>Ideas</option>
          <option>Questions</option>
          <option>General</option>
        </select>
      </p>

      <p style="margin-bottom:12px;">
        <label for="name">Name</label><br />
        <input
          id="name"
          type="text"
          name="name"
          required
          style="width:420px; max-width:100%; padding:8px; font-size:16px; margin-top:6px;"
        />
      </p>

      <p style="margin-bottom:12px;">
        <label for="email">Email</label><br />
        <input
          id="email"
          type="email"
          name="email"
          required
          style="width:420px; max-width:100%; padding:8px; font-size:16px; margin-top:6px;"
        />
      </p>

      <p style="margin-bottom:12px;">
        <label for="message">Message</label><br />
        <textarea
          id="message"
          name="message"
          rows="7"
          required
          style="width:700px; max-width:100%; padding:8px; font-size:16px; margin-top:6px;"
        ></textarea>
      </p>

      <p>
        <button
          type="submit"
          style="padding:10px 24px; font-size:17px;"
        >
          Send
        </button>
      </p>

    </form>

  </main>

  <Footer />
</body>
</html>
