---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
<head>
  <BaseHead
    title="Contact"
    description="Contact Our Malta"
  />

  <style>
    body {
      margin: 0;
      background: white;
      color: #222;
      font-family: system-ui, sans-serif;
    }

    main {
      max-width: 760px;
      margin: 0 auto;
      padding: 2rem 1.5rem 4rem;
    }

    p {
      font-size: 1.15rem;
      line-height: 1.8;
      margin: 0 0 1rem 0;
    }

    label {
      display: block;
      font-size: 1rem;
      margin-bottom: 6px;
    }

    select,
    input {
      width: 300px;
      height: 44px;
      padding: 8px;
      font-size: 1rem;
      box-sizing: border-box;
    }

    textarea {
      width: 100%;
      min-height: 150px;
      padding: 8px;
      font-size: 1rem;
      line-height: 1.6;
      box-sizing: border-box;
      resize: vertical;
    }

    .field {
      margin-bottom: 1.2rem;
    }

    button {
      background: white;
      color: #333;
      border: 1px solid #666;
      border-radius: 4px;
      padding: 8px 24px;
      font-size: 1rem;
      cursor: pointer;
    }

    button:hover {
      background: #f5f5f5;
    }
  </style>
</head>

<body>

  <Header />

  <main>

    <p>
      Pause for a moment...
    </p>

    <p>
      Imagine something uniquely Maltese.
    </p>

    <p>
      What comes to mind?
    </p>

    <p>
      What experience, place, skill, or tradition deserves to be shared?
    </p>

    <p>
      Your perspective could inspire the next great experience in Malta.
    </p>

    <p style="margin-bottom:2rem;">
      We're listening. Share your idea, ask a question, or simply start a conversation.
    </p>

    <form>

      <div class="field">
        <label for="topic">What is this about?</label>

        <select id="topic" name="topic">
          <option>Ideas</option>
          <option>Questions</option>
          <option>General</option>
        </select>
      </div>

      <div class="field">
        <label for="name">Name</label>

        <input
          id="name"
          type="text"
          name="name"
          required
        />
      </div>

      <div class="field">
        <label for="email">Email</label>

        <input
          id="email"
          type="email"
          name="email"
          required
        />
      </div>

      <div class="field">
        <label for="message">Message</label>

        <textarea
          id="message"
          name="message"
          required
        ></textarea>
      </div>

      <button type="submit">
        Send
      </button>

    </form>

  </main>

  <Footer />

</body>
</html>
