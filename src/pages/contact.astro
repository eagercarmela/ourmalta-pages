---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
<head>
  <BaseHead
    title="Get in touch"
    description="Contact Our Malta"
  />
</head>

<body>
  <Header />

  <main style="max-width:700px;margin:0 auto;">

    <h1 style="font-size:30px;margin:0 0 12px 0;">GET IN TOUCH</h1>

    <p style="font-size:20px;margin:6px 0;">
      Pause for a moment...
    </p>

    <p style="font-size:20px;margin:6px 0;">
      Imagine something uniquely Maltese. What comes to mind?
    </p>

    <p style="font-size:20px;margin:6px 0;">
      What experience, place, skill, or tradition deserves to be shared?
    </p>

    <p style="font-size:20px;margin:6px 0;">
      Your perspective could inspire the next great experience in Malta.
    </p>

    <p style="font-size:20px;margin:6px 0 14px 0;">
      We're listening. Share your idea, ask a question, or simply start a conversation.
    </p>

    <form>

      <p style="margin:10px 0;">
        <label for="topic" style="font-size:16px;">What is this about?</label><br />
        <select
          id="topic"
          name="topic"
          style="width:280px;height:38px;font-size:16px;"
        >
          <option>Ideas</option>
          <option>Questions</option>
          <option>General</option>
        </select>
      </p>

      <p style="margin:10px 0;">
        <label for="name" style="font-size:16px;">Name</label><br />
        <input
          id="name"
          type="text"
          name="name"
          required
          style="width:280px;height:38px;font-size:16px;padding:6px;"
        />
      </p>

      <p style="margin:10px 0;">
        <label for="email" style="font-size:16px;">Email</label><br />
        <input
          id="email"
          type="email"
          name="email"
          required
          style="width:280px;height:38px;font-size:16px;padding:6px;"
        />
      </p>

      <p style="margin:10px 0;">
        <label for="message" style="font-size:16px;">Message</label><br />
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          style="width:100%;font-size:16px;padding:8px;resize:vertical;"
        ></textarea>
      </p>

      <p style="margin-top:12px;">
        <button
          type="submit"
          style="font-size:16px;padding:8px 24px;"
        >
          Send
        </button>
      </p>

    </form>

  </main>

  <Footer />
</body>
</html>
