---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
<head>
  <BaseHead
    title="Get in touch"
    description="Contact Our Malta"
  />
</head>

<body>
  <Header />

  <main>

    <h1>Get in touch</h1>

    <p><strong>Pause for a moment...</strong></p>

    <p>
      Imagine something uniquely Maltese. What comes to mind?
    </p>

    <p>
      What experience, place, skill, or tradition deserves to be shared?
    </p>

    <p>
      Your perspective could inspire the next great experience in Malta.
    </p>

    <p>
      <strong>We're listening.</strong>
      Share your idea, ask a question, or simply start a conversation.
    </p>

    <hr />

    <form>

      <p>
        <label for="topic"><strong>What is this about?</strong></label><br />
        <select id="topic" name="topic">
          <option>Suggestions &amp; Ideas</option>
          <option>Questions</option>
          <option>General Contact</option>
        </select>
      </p>

      <p>
        <label for="name"><strong>Name</strong></label><br />
        <input id="name" type="text" name="name" required />
      </p>

      <p>
        <label for="email"><strong>Email</strong></label><br />
        <input id="email" type="email" name="email" required />
      </p>

      <p>
        <label for="message"><strong>Message</strong></label><br />
        <textarea
          id="message"
          name="message"
          rows="8"
          required
        ></textarea>
      </p>

      <p>
        <button type="submit">Send</button>
      </p>

    </form>

  </main>

  <Footer />
</body>
</html>
