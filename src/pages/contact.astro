---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
<head>
  <BaseHead
    title="Get in touch"
    description="Contact Our Malta"
  />
</head>

<body>
  <Header />

  <main style="max-width:700px;margin:0 auto;font-size:12px;line-height:1.2;">

    <h1 style="font-size:24px;margin:0 0 10px 0;">Get in touch</h1>

    <p style="margin:4px 0;">Pause for a moment...</p>

    <p style="margin:4px 0;">
      Imagine something uniquely Maltese. What comes to mind?
    </p>

    <p style="margin:4px 0;">
      What experience, place, skill, or tradition deserves to be shared?
    </p>

    <p style="margin:4px 0;">
      Your perspective could inspire the next great experience in Malta.
    </p>

    <p style="margin:4px 0 10px 0;">
      We're listening. Share your idea, ask a question, or simply start a conversation.
    </p>

    <form>

      <p style="margin:6px 0;">
        <label for="topic">What is this about?</label><br />
        <select
          id="topic"
          name="topic"
          style="width:260px;height:28px;font-size:12px;"
        >
          <option>Ideas</option>
          <option>Questions</option>
          <option>General</option>
        </select>
      </p>

      <p style="margin:6px 0;">
        <label for="name">Name</label><br />
        <input
          id="name"
          type="text"
          name="name"
          required
          style="width:260px;height:28px;font-size:12px;padding:4px;"
        />
      </p>

      <p style="margin:6px 0;">
        <label for="email">Email</label><br />
        <input
          id="email"
          type="email"
          name="email"
          required
          style="width:260px;height:28px;font-size:12px;padding:4px;"
        />
      </p>

      <p style="margin:6px 0;">
        <label for="message">Message</label><br />
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          style="width:100%;font-size:12px;padding:6px;resize:vertical;"
        ></textarea>
      </p>

      <p style="margin-top:8px;">
        <button
          type="submit"
          style="font-size:12px;padding:6px 18px;"
        >
          Send
        </button>
      </p>

    </form>

  </main>

  <Footer />
</body>
</html>

