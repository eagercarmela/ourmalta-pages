---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
<head>
  <BaseHead
    title="Get in touch"
    description="Contact Our Malta"
  />
</head>

<body>
  <Header />

  <main>

    <h1>Get in touch</h1>

    <p><strong>Pause for a moment...</strong></p>

    <p>
      Imagine something uniquely Maltese. What comes to mind?
    </p>

    <p>
      What experience, place, skill, or tradition deserves to be shared?
    </p>

    <p>
      Your perspective could inspire the next great experience in Malta.
    </p>

    <p>
      <strong>We're listening.</strong>
      Share your idea, ask a question, or simply start a conversation.
    </p>

    <hr />

    <form>

      <p>
        <label for="topic"><strong>What is this about?</strong></label><br /><br />
        <select
          id="topic"
          name="topic"
          style="width:320px; padding:8px; font-size:16px;"
        >
          <option>Ideas</option>
          <option>Questions</option>
          <option>General</option>
        </select>
      </p>

      <p>
        <label for="name"><strong>Name</strong></label><br /><br />
        <input
          id="name"
          type="text"
          name="name"
          required
          style="width:100%; max-width:600px; padding:10px; font-size:16px;"
        />
      </p>

      <p>
        <label for="email"><strong>Email</strong></label><br /><br />
        <input
          id="email"
          type="email"
          name="email"
          required
          style="width:100%; max-width:600px; padding:10px; font-size:16px;"
        />
      </p>

      <p>
        <label for="message"><strong>Message</strong></label><br /><br />
        <textarea
          id="message"
          name="message"
          rows="10"
          required
          style="width:100%; max-width:700px; padding:10px; font-size:16px;"
        ></textarea>
      </p>

      <p>
        <button
          type="submit"
          style="padding:12px 28px; font-size:18px; cursor:pointer;"
        >
          Send
        </button>
      </p>

    </form>

  </main>

  <Footer />
</body>
</html>
