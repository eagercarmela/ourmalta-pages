---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
<head>
  <BaseHead
    title="Get in touch"
    description="Contact Our Malta"
  />
</head>

<body>
  <Header />

  <main style="max-width:760px; margin:0 auto;">

    <h1 style="margin-bottom:0.5rem;">Get in touch</h1>

    <p style="margin:0 0 .5rem 0;">Pause for a moment...</p>

    <p style="margin:.4rem 0;">
      Imagine something uniquely Maltese. What comes to mind?
    </p>

    <p style="margin:.4rem 0;">
      What experience, place, skill, or tradition deserves to be shared?
    </p>

    <p style="margin:.4rem 0 .8rem 0;">
      Your perspective could inspire the next great experience in Malta.
    </p>

    <p style="margin:0 0 1rem 0;">
      We're listening. Share your idea, ask a question, or simply start a conversation.
    </p>

    <form>

      <p style="margin:.6rem 0;">
        <label for="topic">What is this about?</label><br />
        <select
          id="topic"
          name="topic"
          style="width:320px;height:38px;font-size:16px;"
        >
          <option>Ideas</option>
          <option>Questions</option>
          <option>General</option>
        </select>
      </p>

      <p style="margin:.6rem 0;">
        <label for="name">Name</label><br />
        <input
          id="name"
          type="text"
          name="name"
          required
          style="width:420px;height:38px;font-size:16px;padding:0 10px;"
        />
      </p>

      <p style="margin:.6rem 0;">
        <label for="email">Email</label><br />
        <input
          id="email"
          type="email"
          name="email"
          required
          style="width:420px;height:38px;font-size:16px;padding:0 10px;"
        />
      </p>

      <p style="margin:.6rem 0;">
        <label for="message">Message</label><br />
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          style="width:100%;height:120px;font-size:16px;padding:10px;"
        ></textarea>
      </p>

      <p style="margin-top:.8rem;">
        <button
          type="submit"
          style="padding:10px 28px;font-size:17px;"
        >
          Send
        </button>
      </p>

    </form>

  </main>

  <Footer />
</body>
</html>
