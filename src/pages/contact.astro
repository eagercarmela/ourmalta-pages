---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
<head>
  <BaseHead
    title="Contact"
    description="Contact Our Malta"
  />
</head>

<body>

  <Header />

  <main>

    <p>
      Pause for a moment...
    </p>

    <p>
      Imagine something uniquely Maltese.
    </p>

    <p>
      What comes to mind?
    </p>

    <p>
      What experience, place, skill, or tradition deserves to be shared?
    </p>

    <p>
      Your perspective could inspire the next great experience.
    </p>

    <p>
      We're listening.
    </p>

    <p>
      Ideas, questions, recommendations, start a conversation or simply say hello.
    </p>

    <p class="email">
      <a href="mailto:contact@ourmalta.org">
        contact@ourmalta.org
      </a>
    </p>

    <p class="note">
      As I'm often traveling, replies may take up to a week. Thank you for your patience.
    </p>

  </main>

</body>

<style>

main {
  max-width: 760px;
  margin: 0 auto;
  padding: 2rem 1.5rem 3rem;
}

p {
  color: #1F3A5F;
  font-family: "Cormorant Garamond", serif;
  font-size: 1.3rem;
  line-height: 1.5;
  margin: 0 0 0.9rem 0;
}

.email {
  font-size: 1.55rem;
  font-weight: 700;
  margin-top: 1.25rem;
  margin-bottom: 0.35rem;
}

.email a {
  color: #1F3A5F;
  text-decoration: none;
}

.email a:hover {
  text-decoration: underline;
}

.note {
  font-size: 1.15rem;
  font-style: italic;
  line-height: 1.45;
  margin-top: 0;
}

</style>

</html>
