  }

  .intro {
    font-family: "Cormorant Garamond", serif;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.6;
    color: #1F3A5F;
    margin: 0 0 2.5rem 0;
  }

  p {
    color: #1F3A5F;
    font-family: "Cormorant Garamond", serif;
    font-size: 1.3rem;
    line-height: 1.7;
    margin: 0 0 1.5rem 0;
  }

  .signature {
    display: block;
    width: 166px;
    max-width: 100%;
    height: auto;
    margin-top: 2.5rem;
    margin-bottom: 0.35rem;
  }

  .email {
    margin: 0;
    color: #1F3A5F;
    font-family: "Cormorant Garamond", serif;
    font-size: 1.3rem;
  }

  .email a {
    color: #1F3A5F;
